<ul xmlns:t="http://twistedmatrix.com/ns/twisted.web.template/0.1">
    <html>
        <head>
            <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/v/dt/dt-1.12.1/datatables.min.css"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@patternfly/patternfly/patternfly.css"/>
            <style>
                #builds tbody tr:hover {
                    background-color: var(--pf-t--global--background--color--secondary--default, #f2f2f2);
                }
            </style>

            <title>ELN Rebuild Status</title>
        </head>
        <body>
            <main id="main-content" role="main" style="padding: 1.5rem; max-width: 100%; min-height: 100%; box-sizing: border-box;">
                <h1 class="pf-v6-c-title pf-m-4xl">ELN Rebuild Status</h1>
            <script type="text/javascript" src="https://cdn.datatables.net/v/dt/jq-3.6.0/dt-1.12.1/fh-3.2.4/rg-1.2.0/datatables.min.js"></script>
            <script>
                $(document).ready(function () {
                    $('#builds thead tr')
                        .clone(true)
                        .addClass('filters')
                        .appendTo('#builds thead');
                        $('#builds').DataTable({
                            orderCellsTop: true,
                            pageLength: 25,
                            paging: true,
                            fixedHeader: true,
                            initComplete: function (settings, json) {
                                var api = this.api();
                                api
                                    .columns()
                                    .every(function (colIdx) {
                                        // Set the footer cell to contain the input element
                                        var cell = $('.filters th').eq(
                                            $(api.column(colIdx).header()).index()
                                        );
                                        var column = this;
                                        var select = $('<select><option value=""></option></select>')
                                            .appendTo($(column.header()).empty())
                                            .on('change', function () {
                                                var val = $.fn.dataTable.util.escapeRegex($(this).val());
                                                column.search(val ? '^' + val + '$' : '', true, false).draw();
                                            });
                                        column
                                            .data()
                                            .unique()
                                            .sort()
                                            .each(function (d, j) {
                                                select.append('<option value="' + d + '">' + d + '</option>');
                                            });
                                    });
                            },
                        });
                });
            </script>
            <p t:render="header">Updated at <t:slot name="update_time"/></p>
            <table id="builds" class="pf-v6-c-table pf-m-compact" style="width:100%" role="grid" aria-label="ELN rebuild build status">
                <thead>
                    <tr class="pf-v6-c-table__thead pf-v6-c-table__tr">
                        <th class="pf-v6-c-table__th">Name</th>
                        <th class="pf-v6-c-table__th">View</th>
                        <th class="pf-v6-c-table__th">Status</th>
                        <th class="pf-v6-c-table__th">Koji Task</th>
                        <th class="pf-v6-c-table__th">Detail</th>
                        <th class="pf-v6-c-table__th">NVR</th>
                        <th class="pf-v6-c-table__th">Current in ELN</th>
                        <th class="pf-v6-c-table__th">Build Time</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t:render="builds" class="pf-v6-c-table__tbody pf-v6-c-table__tr">
                        <td class="pf-v6-c-table__td" data-label="Name"><t:slot name="name"/></td>
                        <td class="pf-v6-c-table__td" data-label="View"><t:slot name="view"/></td>
                        <td class="pf-v6-c-table__td" data-label="Status"><t:slot name="state"/></td>
                        <td class="pf-v6-c-table__td" data-label="Koji Task">
                            <a>
                                <t:attr name="href">
                                    <t:slot name="task_url"/>
                                </t:attr>
                                <t:slot name="task"/>
                            </a>
                        </td>
                        <td class="pf-v6-c-table__td" data-label="Detail"><t:slot name="detail"/></td>
                        <td class="pf-v6-c-table__td" data-label="NVR"><t:slot name="nvr"/></td>
                        <td class="pf-v6-c-table__td" data-label="Current in ELN"><t:slot name="tagged_build"/></td>
                        <td class="pf-v6-c-table__td" data-label="Build Time"><t:slot name="build_time"/></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="pf-v6-c-table__tfoot pf-v6-c-table__tr">
                        <th class="pf-v6-c-table__th">Name</th>
                        <th class="pf-v6-c-table__th">View</th>
                        <th class="pf-v6-c-table__th">Status</th>
                        <th class="pf-v6-c-table__th">Koji Task</th>
                        <th class="pf-v6-c-table__th">Detail</th>
                        <th class="pf-v6-c-table__th">NVR</th>
                        <th class="pf-v6-c-table__th">Current in ELN</th>
                        <th class="pf-v6-c-table__th">Build Time</th>
                    </tr>
                </tfoot>
            </table>
            </main>
        </body>
    </html>
</ul>